<Window x:Class="BEMLPropertyManagement.Views.ComplaintDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complaint Details"
        Height="650"
        Width="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="Complaint Details"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,20"/>

        <!-- DETAILS -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- ASSET -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Asset"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="AssetTextBlock"
                           Grid.Row="0"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- REPORTED BY -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Reported By"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="EmployeeTextBlock"
                           Grid.Row="1"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <!-- COMPLAINT DATE -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Complaint Date"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ComplaintDateTextBlock"
                           Grid.Row="2"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <!-- PROBLEM TITLE -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Problem Title"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="ProblemTitleTextBlock"
                           Grid.Row="3"
                           Grid.Column="1"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <!-- PRIORITY -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Priority"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="PriorityTextBlock"
                           Grid.Row="4"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <!-- STATUS -->
                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Status"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="5"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <!-- PROBLEM DESCRIPTION -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Problem Description"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="ProblemDescriptionTextBlock"
                           Grid.Row="6"
                           Grid.Column="1"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <!-- RESOLVED DATE -->
                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Resolved Date"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ResolvedDateTextBlock"
                           Grid.Row="7"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

                <!-- RESOLUTION NOTES -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Resolution Notes"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                <TextBlock x:Name="ResolutionNotesTextBlock"
                           Grid.Row="8"
                           Grid.Column="1"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <!-- CREATED DATE -->
                <TextBlock Grid.Row="9"
                           Grid.Column="0"
                           Text="Created Date"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CreatedDateTextBlock"
                           Grid.Row="9"
                           Grid.Column="1"
                           VerticalAlignment="Center"/>

            </Grid>

        </ScrollViewer>

        <!-- CLOSE BUTTON -->
        <Button Grid.Row="2"
                Content="Close"
                Width="110"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#1F4E78"
                Foreground="White"
                BorderThickness="0"
                Click="CloseButton_Click"/>

    </Grid>

</Window>