<Window x:Class="BEMLPropertyManagement.Views.ComplaintsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complaints Management - BEML Property Management"
        Height="700"
        Width="1350"
        MinHeight="600"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Complaints Management"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="Track and manage BEML asset complaints"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Content="+ Add Complaint"
                    Width="170"
                    Height="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="AddComplaintButton_Click"/>

        </Grid>


        <!-- SEARCH -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="45"
                     FontSize="14"
                     Padding="12"
                     VerticalContentAlignment="Center"
                     ToolTip="Search complaints..."
                     KeyDown="SearchTextBox_KeyDown"/>

            <Button Grid.Column="1"
                    Content="Search"
                    Height="45"
                    Margin="10,0,0,0"
                    Background="#1F2937"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="SearchButton_Click"/>

        </Grid>


        <!-- COMPLAINT TABLE -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="ComplaintDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="45"
                      FontSize="14"
                      Background="White"
                      BorderThickness="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      FrozenColumnCount="1">

                <DataGrid.Columns>

                    <!-- ASSET -->

                    <DataGridTextColumn Header="Asset"
                                        Binding="{Binding ItemNumber}"
                                        Width="180"
                                        MinWidth="180"/>

                    <!-- COMPLAINT DATE -->

                    <DataGridTextColumn Header="Complaint Date"
                                        Binding="{Binding ComplaintDate}"
                                        Width="120"
                                        MinWidth="120"/>

                    <!-- PROBLEM -->

                    <DataGridTextColumn Header="Problem"
                                        Binding="{Binding ProblemTitle}"
                                        Width="200"
                                        MinWidth="180"/>

                    <!-- PRIORITY -->

                    <DataGridTextColumn Header="Priority"
                                        Binding="{Binding Priority}"
                                        Width="90"
                                        MinWidth="90"/>

                    <!-- STATUS -->

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"
                                        MinWidth="100"/>

                    <!-- REPORTED BY -->

                    <DataGridTextColumn Header="Reported By"
                                        Binding="{Binding EmployeeName}"
                                        Width="150"
                                        MinWidth="140"/>

                    <!-- RESOLVED DATE -->

                    <DataGridTextColumn Header="Resolved Date"
                                        Binding="{Binding ResolvedDate}"
                                        Width="120"
                                        MinWidth="120"/>


                    <!-- ACTIONS -->

                    <DataGridTemplateColumn Header="Actions"
                                            Width="250"
                                            MinWidth="250">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="View"
                                            Width="70"
                                            Height="32"
                                            Margin="2"
                                            Background="#059669"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ViewComplaintButton_Click"/>

                                    <Button Content="Edit"
                                            Width="70"
                                            Height="32"
                                            Margin="2"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="EditComplaintButton_Click"/>

                                    <Button Content="Delete"
                                            Width="70"
                                            Height="32"
                                            Margin="2"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeleteComplaintButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>