<Window x:Class="BEMLPropertyManagement.Views.AddReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Replacement"
        Height="700"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Add Replacement Record"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,25"/>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- OLD ASSET -->
                <TextBlock Text="Old Asset"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="OldAssetComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15"/>

                <!-- NEW ASSET -->
                <TextBlock Text="New Asset"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="NewAssetComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15"/>

                <!-- REPLACEMENT DATE -->
                <TextBlock Text="Replacement Date"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <DatePicker x:Name="ReplacementDatePicker"
                            Height="38"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                <!-- REPLACEMENT REASON -->
                <TextBlock Text="Replacement Reason"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ReplacementReasonTextBox"
                         Height="80"
                         FontSize="14"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,15"/>

                <!-- OLD ASSET CONDITION -->
                <TextBlock Text="Old Asset Condition"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="OldAssetConditionComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="Good"/>
                    <ComboBoxItem Content="Fair"/>
                    <ComboBoxItem Content="Poor"/>
                    <ComboBoxItem Content="Damaged"/>
                    <ComboBoxItem Content="Non-Functional"/>

                </ComboBox>

                <!-- DISPOSAL STATUS -->
                <TextBlock Text="Old Asset Disposal Status"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="DisposalStatusComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="Not Disposed"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Disposed"/>
                    <ComboBoxItem Content="Scrapped"/>
                    <ComboBoxItem Content="Transferred"/>

                </ComboBox>

                <!-- APPROVED BY -->
                <TextBlock Text="Approved By"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ApprovedByTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <!-- REPLACEMENT COST -->
                <TextBlock Text="Replacement Cost"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ReplacementCostTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <!-- REMARKS -->
                <TextBlock Text="Remarks"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="RemarksTextBox"
                         Height="70"
                         FontSize="14"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,20"/>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Width="110"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button Content="Save Replacement"
                            Width="160"
                            Height="40"
                            Background="#1F4E78"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="SaveReplacementButton_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>