<Window x:Class="BEMLPropertyManagement.Views.EditReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Replacement"
        Height="700"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Edit Replacement"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Old Asset -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Old Asset:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="OldAssetComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,5"/>

                <!-- New Asset -->
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="New Asset:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="NewAssetComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,5"/>

                <!-- Replacement Date -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Replacement Date:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <DatePicker x:Name="ReplacementDatePicker"
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="35"
                            Margin="0,5"/>

                <!-- Replacement Reason -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Replacement Reason:"
                           VerticalAlignment="Top"
                           Margin="0,12,0,8"/>

                <TextBox x:Name="ReplacementReasonTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5"/>

                <!-- Old Condition -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Old Asset Condition:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="OldAssetConditionComboBox"
                          Grid.Row="4"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,5">

                    <ComboBoxItem Content="Good"/>
                    <ComboBoxItem Content="Fair"/>
                    <ComboBoxItem Content="Poor"/>
                    <ComboBoxItem Content="Damaged"/>
                    <ComboBoxItem Content="Non-Functional"/>

                </ComboBox>

                <!-- Disposal Status -->
                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Disposal Status:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <ComboBox x:Name="DisposalStatusComboBox"
                          Grid.Row="5"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,5">

                    <ComboBoxItem Content="Not Disposed"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Disposed"/>
                    <ComboBoxItem Content="Scrapped"/>
                    <ComboBoxItem Content="Transferred"/>

                </ComboBox>

                <!-- Approved By -->
                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Approved By:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="ApprovedByTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,5"/>

                <!-- Replacement Cost -->
                <TextBlock Grid.Row="7"
                           Grid.Column="0"
                           Text="Replacement Cost:"
                           VerticalAlignment="Center"
                           Margin="0,8"/>

                <TextBox x:Name="ReplacementCostTextBox"
                         Grid.Row="7"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,5"/>

                <!-- Remarks -->
                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Remarks:"
                           VerticalAlignment="Top"
                           Margin="0,12,0,8"/>

                <TextBox x:Name="RemarksTextBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         Height="70"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,5"/>

            </Grid>

        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Save Changes"
                    Width="140"
                    Height="40"
                    Click="SaveChangesButton_Click"/>

        </StackPanel>

    </Grid>

</Window>