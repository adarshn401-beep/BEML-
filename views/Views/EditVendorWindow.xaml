<Window x:Class="BEMLPropertyManagement.Views.EditVendorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Vendor"
        Height="600"
        Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Edit Vendor"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <!-- Form -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vendor Name -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Vendor Name:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="VendorNameTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Contact Person -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Contact Person:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="ContactPersonTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Phone -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Phone:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="PhoneTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Email -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Email:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="EmailTextBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Address -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Address:"
                       VerticalAlignment="Top"
                       Margin="0,12,0,8"/>

            <TextBox x:Name="AddressTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="90"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,5"/>

            <!-- Status -->
            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Status:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <ComboBox x:Name="StatusComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      Height="35"
                      Margin="0,5">

                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Inactive"/>

            </ComboBox>

        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Save Changes"
                    Width="140"
                    Height="40"
                    Click="SaveChangesButton_Click"/>

        </StackPanel>

    </Grid>

</Window>