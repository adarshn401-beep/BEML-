<Window x:Class="BEMLPropertyManagement.Views.AddWarrantyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Warranty"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Add Warranty Record"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1F2937"
                   Margin="0,0,0,25"/>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- ASSET -->
                <TextBlock Text="Asset"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="AssetComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15"/>

                <!-- WARRANTY PROVIDER -->
                <TextBlock Text="Warranty Provider"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="WarrantyProviderTextBox"
                         Height="38"
                         FontSize="14"
                         Padding="8"
                         Margin="0,0,0,15"/>

                <!-- START DATE -->
                <TextBlock Text="Warranty Start Date"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <DatePicker x:Name="WarrantyStartDatePicker"
                            Height="38"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                <!-- END DATE -->
                <TextBlock Text="Warranty End Date"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <DatePicker x:Name="WarrantyEndDatePicker"
                            Height="38"
                            FontSize="14"
                            Margin="0,0,0,15"/>

                <!-- WARRANTY TYPE -->
                <TextBlock Text="Warranty Type"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="WarrantyTypeComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="Standard"/>
                    <ComboBoxItem Content="Extended"/>
                    <ComboBoxItem Content="On-Site"/>
                    <ComboBoxItem Content="Comprehensive"/>

                </ComboBox>

                <!-- EXTENDED WARRANTY -->
                <CheckBox x:Name="ExtendedWarrantyCheckBox"
                          Content="Extended Warranty"
                          FontSize="14"
                          Margin="0,0,0,15"/>

                <!-- CLAIM STATUS -->
                <TextBlock Text="Claim Status"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="ClaimStatusComboBox"
                          Height="38"
                          FontSize="14"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="Not Claimed"/>
                    <ComboBoxItem Content="Claimed"/>
                    <ComboBoxItem Content="In Progress"/>
                    <ComboBoxItem Content="Approved"/>
                    <ComboBoxItem Content="Rejected"/>

                </ComboBox>

                <!-- CLAIM DESCRIPTION -->
                <TextBlock Text="Claim Description"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ClaimDescriptionTextBox"
                         Height="70"
                         FontSize="14"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,20"/>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Width="110"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button Content="Save Warranty"
                            Width="140"
                            Height="40"
                            Background="#1F4E78"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="SaveWarrantyButton_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>