<Window x:Class="BEMLPropertyManagement.Views.EmployeesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employees Management"
        Height="700"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="25,0">

            <Grid>

                <TextBlock Text="Employees Management"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="+ Add Employee"
                        Width="170"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#1F4E78"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="AddEmployeeButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SEARCH -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="40"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Padding="10"
                         Text="Search employee..."
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button Content="Search"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#1F4E78"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

            </Grid>

            <!-- EMPLOYEE TABLE -->
            <DataGrid x:Name="EmployeeDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="45"
                      FontSize="14"
                      Background="White"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Employee Code"
                                        Binding="{Binding EmployeeCode}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Employee Name"
                                        Binding="{Binding EmployeeName}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Designation"
                                        Binding="{Binding Designation}"
                                        Width="210"/>

                    <DataGridTextColumn Header="Department"
                                        Binding="{Binding Department}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="270"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="120"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions"
                                            Width="250">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <!-- VIEW -->
                                    <Button Content="View"
                                            Width="65"
                                            Height="30"
                                            Margin="2"
                                            Background="#00A884"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ViewEmployeeButton_Click"/>

                                    <!-- EDIT -->
                                    <Button Content="Edit"
                                            Width="65"
                                            Height="30"
                                            Margin="2"
                                            Background="#2F66D0"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="EditEmployeeButton_Click"/>

                                    <!-- DELETE -->
                                    <Button Content="Delete"
                                            Width="70"
                                            Height="30"
                                            Margin="2"
                                            Background="#E52B2B"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeleteEmployeeButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>