<Window x:Class="BEMLPropertyManagement.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management"
        Height="700"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="25,0">
            <Grid>
                <TextBlock Text="User Management"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="+ Add User"
                        Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#1F4E78"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="AddUserButton_Click"/>
            </Grid>
        </Border>

        <!-- Search -->
        <Grid Grid.Row="1"
              Margin="20,10,20,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="40"
                     FontSize="15"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     Text="Search users..."
                     KeyDown="SearchTextBox_KeyDown"/>

            <Button Content="Search"
                    Grid.Column="1"
                    Width="100"
                    Height="40"
                    Margin="10,0,0,0"
                    Background="#1F4E78"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="SearchButton_Click"/>
        </Grid>

        <!-- Users DataGrid -->
        <DataGrid x:Name="UsersDataGrid"
                  Grid.Row="2"
                  Margin="20,5,20,20"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="45"
                  FontSize="14"
                  Background="White"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Username"
                                    Binding="{Binding Username}"
                                    Width="150"/>

                <DataGridTextColumn Header="Full Name"
                                    Binding="{Binding FullName}"
                                    Width="200"/>

                <DataGridTextColumn Header="Role"
                                    Binding="{Binding Role}"
                                    Width="130"/>

                <DataGridTextColumn Header="Employee"
                                    Binding="{Binding EmployeeName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="100"/>

                <DataGridTemplateColumn Header="Actions"
                                        Width="300">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <Button Content="View"
                                        Width="65"
                                        Height="36"
                                        Margin="3"
                                        Background="#009879"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Click="ViewUserButton_Click"/>

                                <Button Content="Edit"
                                        Width="65"
                                        Height="36"
                                        Margin="3"
                                        Background="#2F66D0"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Click="EditUserButton_Click"/>

                                <Button Content="Delete"
                                        Width="70"
                                        Height="36"
                                        Margin="3"
                                        Background="#E52B2B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Click="DeleteUserButton_Click"/>

                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>