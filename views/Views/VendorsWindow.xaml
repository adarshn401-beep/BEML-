<Window x:Class="BEMLPropertyManagement.Views.VendorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vendors Management"
        Height="650"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="25,0">

            <Grid>

                <TextBlock Text="Vendors Management"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="+ Add Vendor"
                        Width="150"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#1F4E78"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="AddVendorButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SEARCH -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="40"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Padding="10"
                         Text="Search vendor..."
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button Content="Search"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#1F4E78"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

            </Grid>

            <!-- VENDORS TABLE -->
            <DataGrid x:Name="VendorDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      RowHeight="45"
                      FontSize="14"
                      Background="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Vendor Name"
                                        Binding="{Binding VendorName}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Contact Person"
                                        Binding="{Binding ContactPerson}"
                                        Width="170"/>

                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="220"/>

                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding Address}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions"
                                            Width="260">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <!-- VIEW -->
                                    <Button Content="View"
                                            Width="65"
                                            Height="36"
                                            Margin="3"
                                            Background="#009879"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="ViewVendorButton_Click"/>

                                    <!-- EDIT -->
                                    <Button Content="Edit"
                                            Width="65"
                                            Height="36"
                                            Margin="3"
                                            Background="#2F66D0"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="EditVendorButton_Click"/>

                                    <!-- DELETE -->
                                    <Button Content="Delete"
                                            Width="70"
                                            Height="36"
                                            Margin="3"
                                            Background="#E52B2B"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="DeleteVendorButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>