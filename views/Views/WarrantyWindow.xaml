<Window x:Class="BEMLPropertyManagement.Views.WarrantyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warranty Management"
        Height="700"
        Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="25,0">

            <Grid>

                <TextBlock Text="Warranty Management"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="+ Add Warranty"
                        Width="150"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#1F4E78"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="AddWarrantyButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SEARCH -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="40"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Padding="10"
                         Text="Search warranty..."
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button Content="Search"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#1F4E78"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

            </Grid>

            <!-- WARRANTY TABLE -->
            <DataGrid x:Name="WarrantyDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="45"
                      FontSize="14"
                      Background="White">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Asset"
                                        Binding="{Binding ItemNumber}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Provider"
                                        Binding="{Binding WarrantyProvider}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Start Date"
                                        Binding="{Binding WarrantyStartDate}"
                                        Width="130"/>

                    <DataGridTextColumn Header="End Date"
                                        Binding="{Binding WarrantyEndDate}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Warranty Type"
                                        Binding="{Binding WarrantyType}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Extended"
                                        Binding="{Binding ExtendedWarranty}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Claim Status"
                                        Binding="{Binding ClaimStatus}"
                                        Width="140"/>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions"
                                            Width="300">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <!-- VIEW BUTTON -->
                                    <Button Content="View"
                                            Width="65"
                                            Height="36"
                                            Margin="3"
                                            Background="#009879"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="ViewWarrantyButton_Click"/>

                                    <!-- EDIT BUTTON -->
                                    <Button Content="Edit"
                                            Width="65"
                                            Height="36"
                                            Margin="3"
                                            Background="#2F66D0"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="EditWarrantyButton_Click"/>

                                    <!-- DELETE BUTTON -->
                                    <Button Content="Delete"
                                            Width="70"
                                            Height="36"
                                            Margin="3"
                                            Background="#E52B2B"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Click="DeleteWarrantyButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>

</Window>