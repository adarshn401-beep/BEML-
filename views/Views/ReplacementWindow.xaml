<Window x:Class="BEMLPropertyManagement.Views.ReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replacement Management"
        Height="700"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#1F4E78"
                Padding="25,0">

            <Grid>

                <TextBlock Text="Replacement Management"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="+ Add Replacement"
                        Width="170"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="#1F4E78"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="AddReplacementButton_Click"/>

            </Grid>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SEARCH -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="40"
                         VerticalContentAlignment="Center"
                         FontSize="15"
                         Padding="10"
                         Text="Search replacement..."
                         KeyDown="SearchTextBox_KeyDown"/>

                <Button Content="Search"
                        Grid.Column="1"
                        Width="100"
                        Height="40"
                        Margin="10,0,0,0"
                        Background="#1F4E78"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

            </Grid>

            <!-- REPLACEMENT TABLE -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="10">

                <DataGrid x:Name="ReplacementDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="45"
                          FontSize="14"
                          Background="White"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <!-- OLD ASSET -->
                        <DataGridTextColumn Header="Old Asset"
                                            Binding="{Binding OldItemNumber}"
                                            Width="1.2*"/>

                        <!-- NEW ASSET -->
                        <DataGridTextColumn Header="New Asset"
                                            Binding="{Binding NewItemNumber}"
                                            Width="1.2*"/>

                        <!-- REPLACEMENT DATE -->
                        <DataGridTextColumn Header="Replacement Date"
                                            Binding="{Binding ReplacementDate, StringFormat={}{0:dd-MM-yyyy}}"
                                            Width="1.1*"/>

                        <!-- REASON -->
                        <DataGridTextColumn Header="Reason"
                                            Binding="{Binding ReplacementReason}"
                                            Width="1.5*"/>

                        <!-- OLD CONDITION -->
                        <DataGridTextColumn Header="Old Condition"
                                            Binding="{Binding OldAssetCondition}"
                                            Width="1.1*"/>

                        <!-- DISPOSAL STATUS -->
                        <DataGridTextColumn Header="Disposal Status"
                                            Binding="{Binding DisposalStatus}"
                                            Width="1.2*"/>

                        <!-- APPROVED BY -->
                        <DataGridTextColumn Header="Approved By"
                                            Binding="{Binding ApprovedBy}"
                                            Width="1.2*"/>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="Actions"
                                                Width="250">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <Button Content="View"
                                                Width="65"
                                                Height="30"
                                                Margin="2"
                                                Background="#009B77"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="ViewReplacementButton_Click"/>

                                        <Button Content="Edit"
                                                Width="65"
                                                Height="30"
                                                Margin="2"
                                                Background="#2864E6"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="EditReplacementButton_Click"/>

                                        <Button Content="Delete"
                                                Width="65"
                                                Height="30"
                                                Margin="2"
                                                Background="#E52B2B"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="DeleteReplacementButton_Click"/>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>