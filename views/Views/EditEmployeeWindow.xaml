<Window x:Class="BEMLPropertyManagement.Views.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Employee"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Text="Edit Employee"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <!-- FORM -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Employee Code -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Employee Code:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="EmployeeCodeTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Employee Name -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Employee Name:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="EmployeeNameTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Designation -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Designation:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="DesignationTextBox"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Department -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Department:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <ComboBox x:Name="DepartmentComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Height="35"
                      Margin="0,5"/>

            <!-- Phone -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Phone:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="PhoneTextBox"
                     Grid.Row="4"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Email -->
            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Email:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <TextBox x:Name="EmailTextBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     Height="35"
                     Margin="0,5"/>

            <!-- Status -->
            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="Status:"
                       VerticalAlignment="Center"
                       Margin="0,8"/>

            <ComboBox x:Name="StatusComboBox"
                      Grid.Row="6"
                      Grid.Column="1"
                      Height="35"
                      Margin="0,5">

                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Inactive"/>

            </ComboBox>

        </Grid>

        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Save Changes"
                    Width="140"
                    Height="40"
                    Click="SaveChangesButton_Click"/>

        </StackPanel>

    </Grid>

</Window>