<Window x:Class="BEMLPropertyManagement.Views.AssetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEML - Asset Management"
        Height="700"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Asset Management"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Manage BEML property and assets"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- SEARCH / ACTION BAR -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="40"
                     FontSize="14"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Button Grid.Column="1"
                    Content="Search"
                    Height="40"
                    Margin="10,0,5,0"
                    Background="#1F2937"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SearchButton_Click"/>

            <Button Grid.Column="2"
                    Content="+ Add Asset"
                    Height="40"
                    Margin="5,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="AddAssetButton_Click"/>

            <Button Grid.Column="3"
                    Content="Refresh"
                    Height="40"
                    Margin="5,0,0,0"
                    Background="#6B7280"
                    Foreground="White"
                    BorderThickness="0"
                    Click="RefreshButton_Click"/>

        </Grid>

        <!-- ASSET TABLE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="AssetsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      SelectionChanged="AssetsDataGrid_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding AssetId}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Item Number"
                                        Binding="{Binding ItemNumber}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Asset Type"
                                        Binding="{Binding AssetTypeName}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Brand"
                                        Binding="{Binding Brand}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Model"
                                        Binding="{Binding Model}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Serial Number"
                                        Binding="{Binding SerialNumber}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Division"
                                        Binding="{Binding DivisionName}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Vendor"
                                        Binding="{Binding VendorName}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Purchase Date"
                                        Binding="{Binding PurchaseDate, StringFormat=dd-MM-yyyy}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Condition"
                                        Binding="{Binding AssetCondition}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- BOTTOM ACTION BAR -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <!-- DELETE ASSET -->
            <Button x:Name="DeleteAssetButton"
                    Content="Delete Asset"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="DeleteAssetButton_Click"/>

            <!-- EDIT ASSET -->
            <Button x:Name="EditAssetButton"
                    Content="Edit Asset"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="EditAssetButton_Click"/>

            <!-- VIEW DETAILS -->
            <Button x:Name="ViewDetailsButton"
                    Content="View Details"
                    Width="130"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#059669"
                    Foreground="White"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="ViewDetailsButton_Click"/>

        </StackPanel>

    </Grid>

</Window>