<Window x:Class="BEMLPropertyManagement.Views.ServiceRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Records - BEML Property Management"
        Height="700"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Service Records"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#111827"/>

            <TextBlock Text="Track asset complaints, services and maintenance"
                       FontSize="15"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ACTION BAR -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="40"
                     Margin="0,0,10,0"
                     Padding="10"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     ToolTip="Search by asset, problem, provider or status"
                     KeyDown="SearchTextBox_KeyDown"/>

            <Button Grid.Column="1"
                    Content="Search"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#1F2937"
                    Foreground="White"
                    BorderThickness="0"
                    Click="SearchButton_Click"/>

            <Button Grid.Column="2"
                    Content="+ Add Service Record"
                    Width="180"
                    Height="40"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="AddServiceButton_Click"/>

        </Grid>

        <!-- SERVICE TABLE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <DataGrid x:Name="ServiceDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="42"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <!-- ASSET -->
                    <DataGridTextColumn Header="Asset"
                                        Binding="{Binding ItemNumber}"
                                        Width="180"/>

                    <!-- COMPLAINT DATE -->
                    <DataGridTextColumn Header="Complaint Date"
                                        Binding="{Binding ComplaintDate}"
                                        Width="130"/>

                    <!-- PROBLEM -->
                    <DataGridTextColumn Header="Problem"
                                        Binding="{Binding ProblemDescription}"
                                        Width="300"/>

                    <!-- SERVICE DATE -->
                    <DataGridTextColumn Header="Service Date"
                                        Binding="{Binding ServiceDate}"
                                        Width="130"/>

                    <!-- SERVICE PROVIDER -->
                    <DataGridTextColumn Header="Service Provider"
                                        Binding="{Binding ServiceProvider}"
                                        Width="180"/>

                    <!-- COST -->
                    <DataGridTextColumn Header="Cost"
                                        Binding="{Binding ServiceCost}"
                                        Width="110"/>

                    <!-- STATUS -->
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="110">

                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Completed">

                                        <Setter Property="Foreground"
                                                Value="#059669"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Open">

                                        <Setter Property="Foreground"
                                                Value="#D97706"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="Cancelled">

                                        <Setter Property="Foreground"
                                                Value="#DC2626"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </DataGridTextColumn.CellStyle>

                    </DataGridTextColumn>

                    <!-- NEXT SERVICE -->
                    <DataGridTextColumn Header="Next Service"
                                        Binding="{Binding NextServiceDate}"
                                        Width="140">

                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding NextServiceDate}"
                                                 Value="OVERDUE">

                                        <Setter Property="Foreground"
                                                Value="#DC2626"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding NextServiceDate}"
                                                 Value="DUE SOON">

                                        <Setter Property="Foreground"
                                                Value="#D97706"/>

                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding NextServiceDate}"
                                                 Value="-">

                                        <Setter Property="Foreground"
                                                Value="#6B7280"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </DataGridTextColumn.CellStyle>

                    </DataGridTextColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="Actions"
                                            Width="270">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <!-- VIEW -->
                                    <Button Content="View"
                                            Width="70"
                                            Height="30"
                                            Margin="3"
                                            Background="#059669"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ViewServiceButton_Click"/>

                                    <!-- EDIT -->
                                    <Button Content="Edit"
                                            Width="70"
                                            Height="30"
                                            Margin="3"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="EditServiceButton_Click"/>

                                    <!-- DELETE -->
                                    <Button Content="Delete"
                                            Width="70"
                                            Height="30"
                                            Margin="3"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeleteServiceButton_Click"/>

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>