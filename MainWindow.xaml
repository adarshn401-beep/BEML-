<Window x:Class="BEMLPropertyManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BEML Property Management System"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="#1F2937">

            <StackPanel>

                <TextBlock Text="BEML"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,5"/>

                <TextBlock Text="Property Management"
                           Foreground="#D1D5DB"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,35"/>

                <!-- DASHBOARD -->
                <Button Content="Dashboard"
                        Height="45"
                        Margin="15,5"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"/>

                <!-- ASSETS -->
                <Button Content="Assets"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AssetsButton_Click"/>

                <!-- SERVICE RECORDS -->
                <Button Content="Service Records"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ServiceRecordsButton_Click"/>

                <!-- COMPLAINTS -->
                <Button Content="Complaints"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ComplaintsButton_Click"/>

                <!-- WARRANTY -->
                <Button Content="Warranty"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="WarrantyButton_Click"/>

                <!-- REPLACEMENT -->
                <Button Content="Replacement"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ReplacementButton_Click"/>

                <!-- VENDORS -->
                <Button Content="Vendors"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="VendorsButton_Click"/>

                <!-- EMPLOYEES -->
                <Button Content="Employees"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="EmployeesButton_Click"/>

                <!-- REPORTS -->
                <Button Content="Reports"
                        Height="45"
                        Margin="15,5"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ReportsButton_Click"/>

                <!-- LOGOUT -->
                <Button Content="Logout"
                        Height="45"
                        Margin="15,25,15,5"
                        Background="#991B1B"
                        Foreground="White"
                        BorderThickness="0"
                        Click="LogoutButton_Click"/>

            </StackPanel>

        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock Text="Dashboard"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="BEML Property Management System"
                           FontSize="15"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- SUMMARY CARDS -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL ASSETS -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Total Assets"
                                   FontSize="14"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TotalAssetsTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- ASSET TYPES -->
                <Border Grid.Row="0"
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Asset Types"
                                   FontSize="14"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="AssetTypesTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- DEPARTMENTS -->
                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Departments"
                                   FontSize="14"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="DepartmentsTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- EMPLOYEES -->
                <Border Grid.Row="0"
                        Grid.Column="3"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Employees"
                                   FontSize="14"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="EmployeesTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- EXPIRED WARRANTIES -->
                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="#FEE2E2"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="ExpiredWarrantiesCard_Click">

                    <StackPanel>

                        <TextBlock Text="Expired Warranties"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#991B1B"/>

                        <TextBlock x:Name="ExpiredWarrantiesTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#991B1B"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- EXPIRING WARRANTIES -->
                <Border Grid.Row="1"
                        Grid.Column="1"
                        Background="#FEF3C7"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="ExpiringWarrantiesCard_Click">

                    <StackPanel>

                        <TextBlock Text="Warranties Expiring Soon"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"/>

                        <TextBlock x:Name="ExpiringWarrantiesTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#92400E"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- ASSETS DUE FOR REPLACEMENT -->
                <Border Grid.Row="1"
                        Grid.Column="2"
                        Background="#FEE2E2"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="AssetsDueReplacementCard_Click">

                    <StackPanel>

                        <TextBlock Text="Assets Due for Replacement"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#991B1B"/>

                        <TextBlock x:Name="AssetsDueReplacementTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#991B1B"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- REPLACEMENT DUE SOON -->
                <Border Grid.Row="1"
                        Grid.Column="3"
                        Background="#FEF3C7"
                        CornerRadius="10"
                        Margin="5"
                        Padding="15"
                        Cursor="Hand"
                        MouseLeftButtonUp="ReplacementDueSoonCard_Click">

                    <StackPanel>

                        <TextBlock Text="Replacement Due Soon"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"/>

                        <TextBlock x:Name="AssetsApproachingReplacementTextBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#92400E"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- LOWER SECTION -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- DIVISIONS -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Divisions"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Truck Division"
                                   FontSize="16"
                                   Margin="0,8"/>

                        <TextBlock Text="Engine Division"
                                   FontSize="16"
                                   Margin="0,8"/>

                        <TextBlock Text="Aerospace Division"
                                   FontSize="16"
                                   Margin="0,8"/>

                    </StackPanel>

                </Border>

                <!-- SYSTEM INFORMATION -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Margin="5"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="System Information"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Database: Connected"
                                   FontSize="16"
                                   Margin="0,8"/>

                        <TextBlock Text="SQL Server: Local"
                                   FontSize="16"
                                   Margin="0,8"/>

                        <TextBlock Text="System Status: Active"
                                   FontSize="16"
                                   Margin="0,8"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>